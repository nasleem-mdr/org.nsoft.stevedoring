Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: NSoft Stevedoring Module
Bundle-SymbolicName: org.nsoft.stevedoring;singleton:=true
Bundle-Version: 1.0.0.qualifier
Automatic-Module-Name: org.nsoft.stevedoring
Bundle-Activator: org.nsoft.stevedoring.base.Activator
Bundle-Vendor: NSoft
Service-Component: OSGI-INF/stevedoring-model-factory.xml,
 OSGI-INF/stevedoring-validator-factory.xml
Require-Bundle: org.adempiere.base;bundle-version="13.0.0"
Import-Package: org.osgi.framework;version="1.8.0"
Bundle-RequiredExecutionEnvironment: JavaSE-17
Bundle-ActivationPolicy: lazy
Export-Package: org.nsoft.stevedoring.model,
 org.nsoft.stevedoring.service,
 org.nsoft.stevedoring.validator,
 org.nsoft.stevedoring.process,
 org.nsoft.stevedoring.callout,
 org.nsoft.stevedoring.base
